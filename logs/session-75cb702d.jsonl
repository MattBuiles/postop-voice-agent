{"ts": "2026-08-09T14:23:39.765+00:00", "call_id": "75cb702d", "evento": "turno_agente", "slot": "movilidad", "texto_paciente": "Gracias a Dios, me muevo bien, camino normal y me levanto sin problema.", "texto_agente": "¿Cómo ha visto la herida? ¿Le nota enrojecimiento, hinchazón o alguna secreción?", "modo": "voz", "latencias": {"stt": 1861.2, "extraccion": 3068.8, "primer_audio": 3078.4, "total": 3078.5}, "latencia_total_ms": 3078.424833999634, "tokens": {"entrada": 371, "salida": 7, "invocaciones": 1}, "decision": {"nivel": "verde", "perfil": "conservative", "puntaje_amarillo": 0, "banderas_rojas": [], "motivos": []}, "guionada": true}
