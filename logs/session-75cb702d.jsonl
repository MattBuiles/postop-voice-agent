{"ts": "2026-08-09T14:22:59.072+00:00", "call_id": "75cb702d", "evento": "turno_agente", "slot": "dolor_nrs", "texto_paciente": "Sí, claro, adelante.", "texto_agente": "¿Cómo ha sentido el dolor desde la cirugía? En una escala del cero al diez, ¿qué tanto le duele?", "modo": "voz", "latencias": {"stt": 1707.4, "extraccion": 1707.7, "primer_audio": 1715.1, "total": 1715.1}, "latencia_total_ms": 1715.0599939996027, "tokens": {"entrada": 0, "salida": 0, "invocaciones": 0}, "decision": {"nivel": "verde", "perfil": "conservative", "puntaje_amarillo": 0, "banderas_rojas": [], "motivos": []}, "guionada": true}
