{"ts": "2026-08-08T13:23:27.241+00:00", "call_id": "b8300de2", "evento": "turno_agente", "slot": "dolor_nrs", "texto_paciente": "Sí, señora, muchas gracias.", "texto_agente": "¿Cómo ha sentido el dolor desde la cirugía? En una escala del cero al diez, ¿qué tanto le duele?", "modo": "voz", "latencias": {"stt": 1803.1, "extraccion": 1803.5, "primer_audio": 1812.5, "total": 1812.6}, "latencia_total_ms": 1812.4912379998932, "tokens": {"entrada": 0, "salida": 0, "invocaciones": 0}, "decision": {"nivel": "verde", "perfil": "conservative", "puntaje_amarillo": 0, "banderas_rojas": [], "motivos": []}, "guionada": true}
