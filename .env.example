# Copiar a .env. Ningun valor aqui es un secreto real.
# La solucion no necesita ninguna credencial ni cuenta en ningun servicio.
#
# Hay DOS modelos y es facil confundirlos:
#   LLM_MODEL   Llama. Convierte el texto del paciente en slots clinicos.
#   ASR_MODEL   Whisper. Convierte la voz del paciente en texto.
# Son independientes y se eligen por criterios distintos.

# --- Modelo de lenguaje (compuerta G3, la unica que descalifica) ---
#
# El reto permite FAMILIAS de modelos, no versiones exactas, y admite el sucesor
# vigente cuando un proveedor retira una version:
#
#   Meta Llama serie 3.x (1B-3B) local   ->  llama3.2:3b, llama3.2:1b, llama3.3:*
#   Microsoft Phi Mini serie 3.5+ local  ->  phi3.5
#   Google Gemini gama Flash (nube)      ->  gemini-*-flash
#   Meta Llama via Groq (nube)           ->  el vigente en Groq
#
# La aplicacion aborta el arranque si el modelo no pertenece a ninguna familia
# permitida (ver src/postop/config.py). Modelos de OpenAI, Mistral o DeepSeek
# descalifican la entrega.
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434

# Modelo pequeno solo para extraer slots (arquitectura de dos niveles).
#
# SE DEJA VACIO A PROPOSITO. llama3.2:1b extrae en 801 ms frente a los 1545 ms
# del 3B, pero medido sobre 40 turnos reales del dataset acierta 25/40 (62%)
# frente a 35/40 (88%). Pierde sobre todo en apetito (5/10 vs 8/10) y movilidad
# (5/11 vs 8/11), y esos errores mueven el triaje.
#
# 744 ms por turno no valen 26 puntos de exactitud clinica.
LLM_EXTRACTOR_MODEL=

# --- Embeddings ---
# fastembed (ONNX, sin torch, arranque rapido) | bge-m3 (requiere extra "bge")
#
# El indice versionado en data/knowledge.db esta construido con este modelo
# (768 dimensiones). Cambiarlo obliga a reindexar: la aplicacion aborta el
# arranque si detecta otra dimension, en vez de mezclar en silencio dos espacios
# vectoriales incompatibles.
#
# La eleccion esta medida: gana a multilingual-e5-large y empata con BGE-M3 sin
# arrastrar torch. El benchmark esta en src/postop/rag/embed.py
EMBED_BACKEND=fastembed
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- Voz: reconocimiento (Whisper, voz -> texto) ---
#
# OJO: no confundir con LLM_MODEL. Son dos modelos distintos:
#   ASR_MODEL   Whisper. Convierte la voz del paciente en texto.
#   LLM_MODEL   Llama. Convierte ese texto en slots clinicos.
#
# Comparados sobre 10 enunciados del dataset sintetizados con voz colombiana
# (eval/run_asr_bench.py):
#
#   tamano   mediana    WER    slots correctos
#   tiny      487 ms   16.4%   7/10
#   base      661 ms   21.0%   9/10
#   small    1868 ms    8.1%   8/10   <- entregado
#   medium       --      --      --   inviable en 8-16 GB junto al LLM
#
# Sobre ese banco `base` salia mejor, pero su audio de prueba esta SINTETIZADO:
# es limpio y no pasa por un microfono. Contrastado despues con voz real, `base`
# transcribia claramente peor ("no podios cancelir ni hormignada" en una llamada
# de prueba), asi que se entrega `small`.
#
# La leccion queda anotada en el propio banco: sirve para ordenar por latencia,
# no para predecir calidad sobre habla real.
ASR_BACKEND=faster-whisper
ASR_MODEL=small

# --- Voz: sintesis (texto -> voz) ---
#
# edge   Voces colombianas neuronales (es-CO-SalomeNeural, es-CO-GonzaloNeural).
#        Sin credenciales y sin modelo en memoria. Requiere red.
# piper  Local y sin red, ~270 ms al primer audio. Voces es_MX / es_ES / es_AR.
#
# Se entrega `edge` porque los pacientes del reto son colombianos y ninguna voz
# de Piper lo es. Si el servicio no esta disponible -- sin red, o porque
# Microsoft rote su token de autenticacion, cosa que ya ocurrio una vez durante
# el desarrollo -- la aplicacion se repliega sola a Piper. Una voz peor es
# preferible a quedarse sin voz, que seria fallar la compuerta G4.
#
# Medido en una llamada real: con el cache pre-sintetizado la sintesis cuesta
# entre 7 y 40 ms por turno en AMBOS backends, porque casi todo lo que dice el
# agente es texto fijo. La diferencia solo se paga en las respuestas generadas.
#
# El audio del paciente nunca sale de la maquina en ninguno de los dos casos:
# la transcripcion es siempre local. Con `piper`, tampoco sale el texto.
TTS_BACKEND=edge
TTS_VOICE=es-CO-SalomeNeural
# Para el backend local, sustituir las dos lineas anteriores por:
#   TTS_BACKEND=piper
#   TTS_VOICE=es_MX-claude-high

# --- Triaje ---
# conservative: prioriza no perder ningun caso grave (default clinico)
# optimal: maxima exactitud sobre el ground truth del reto
TRIAGE_PROFILE=conservative

# --- Rutas ---
DB_PATH=data/knowledge.db
LOG_DIR=logs
DATASET_DIR=challenge-data/dataset
